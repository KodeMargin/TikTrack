{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "tsc -b && vite build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "api/prisma.mjs",
      "buildCommand": "prisma generate && npm run build:api"
    }
  },
  "rewrites": [
    {
      "source": "/api/prisma/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
