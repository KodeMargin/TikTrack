// =============================================================================
// DevProof (TikTrack) - Prisma ORM Schema for Supabase PostgreSQL
// Maps Phase 1 & Phase 2 Migrations 0001..0007 (Multi-Tenant Identity, Projects,
// Tasks, Work Sessions, Time Segments, Contracts, Timesheets, Reviews, Invoices,
// Activity Ingestion, IDE Mappings, GitHub/GitLab Webhooks & Evidence Links)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 1. Core Tenancy, Identity, RBAC, Consent, Devices & Audit Log (0001)
// -----------------------------------------------------------------------------

model Tenant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String   @unique
  defaultTimezone String   @default("UTC") @map("default_timezone")
  defaultCurrency String   @default("USD") @map("default_currency")
  planTier        String   @default("starter") @map("plan_tier")
  status          String   @default("active")
  aiEnabled       Boolean  @default(false) @map("ai_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings       TenantSettings?
  memberships    Membership[]
  policyVersions PolicyVersion[]
  devices        Device[]
  auditEntries   AuditEntry[]
  projects       Project[]
  contracts      Contract[]
  timesheets     Timesheet[]
  invoiceDrafts  InvoiceDraft[]
  notifications  Notification[]

  // Phase 2 relations
  privacyExclusions     PrivacyExclusion[]
  activityEventBatches  ActivityEventBatch[]
  activityEvents        ActivityEvent[]
  activityRollups       ActivityRollup[]
  connectedIntegrations ConnectedIntegration[]
  repositoryLinks       RepositoryLink[]
  ideWorkspaceMappings  IdeWorkspaceMapping[]
  webhookReceipts       WebhookReceipt[]
  evidenceArtifacts     EvidenceArtifact[]
  evidenceLinks         EvidenceLink[]
  sessionAnnotations    SessionAnnotation[]

  // Phase 3 relations
  verificationRuleSets      VerificationRuleSet[]
  segmentRuleEvaluations    SegmentRuleEvaluation[]
  evidenceCorrelationEdges  EvidenceCorrelationEdge[]
  aiGenerations             AiGeneration[]

  // Phase 4 relations
  subscriptionAccount       SubscriptionAccount?
  saasSubscriptionInvoices  SaasSubscriptionInvoice[]
  usageRecords              UsageRecord[]
  apiKeys                   ApiKey[]
  outboundWebhookEndpoints  OutboundWebhookEndpoint[]
  outboundWebhookDeliveries OutboundWebhookDelivery[]
  ecosystemConnectors       EcosystemConnector[]
  calendarMeetingEvents     CalendarMeetingEvent[]
  portableWorkReports       PortableWorkReport[]

  // Phase 5 relations
  ssoProviders              SsoProvider[]
  scimProvisioningEvents    ScimProvisioningEvent[]
  policyChangeRequests      PolicyChangeRequest[]
  sensitiveAccessLogs       SensitiveAccessLog[]
  legalHolds                LegalHold[]
  retentionPolicies         RetentionPolicy[]
  retentionJobs             RetentionJob[]
  privacyRequests           PrivacyRequest[]
  residencyConfig           TenantResidencyConfig?
  siemDestinations          SiemDestination[]
  siemExportBatches         SiemExportBatch[]
  fleetReleases             FleetRelease[]
  analyticsWarehouseExports AnalyticsWarehouseExport[]
  drExercises               DrExercise[]
  securityAssessments       SecurityAssessment[]
  accessibilityConfig       TenantAccessibilityConfig?

  // Granular RBAC relations
  roles                     Role[]
  tenantOwnerPolicy         TenantOwnerPermissionPolicy?

  @@unique([id, slug])
  @@map("tenants")
}

model UserProfile {
  id              String   @id @db.Uuid
  email           String
  fullName        String   @map("full_name")
  avatarUrl       String?  @map("avatar_url")
  defaultTimezone String   @default("UTC") @map("default_timezone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships        Membership[]        @relation("UserMemberships")
  invitedMemberships Membership[]        @relation("InvitedByUser")
  grantedRoles       RoleGrant[]
  publishedPolicies  PolicyVersion[]
  policyConsents     PolicyConsent[]
  devices            Device[]
  auditEntries       AuditEntry[]
  createdProjects    Project[]
  projectMemberships ProjectMember[]
  taskAssignments    TaskAssignment[]    @relation("AssignedUser")
  assignedTasks      TaskAssignment[]    @relation("AssignedByUser")
  taskNotes          TaskNote[]
  workSessions       WorkSession[]
  timeSegments       TimeSegment[]
  sessionAdjustments SessionAdjustment[]
  contracts          Contract[]
  createdRates       ContractRateVersion[]
  timesheets         Timesheet[]
  reviewDecisions    ReviewDecision[]
  openedDisputes     Dispute[]
  disputeMessages    DisputeMessage[]
  notifications      Notification[]

  // Phase 2 relations
  privacyExclusions     PrivacyExclusion[]
  activityEventBatches  ActivityEventBatch[]
  activityEvents        ActivityEvent[]
  activityRollups       ActivityRollup[]
  connectedIntegrations ConnectedIntegration[]
  ideWorkspaceMappings  IdeWorkspaceMapping[]
  evidenceArtifacts     EvidenceArtifact[]
  sessionAnnotations    SessionAnnotation[]

  // Phase 3 relations
  createdRuleSets     VerificationRuleSet[]
  aiGenerations       AiGeneration[]         @relation("AiGenerationAuthor")
  approvedAiDrafts    AiGeneration[]         @relation("AiGenerationApprover")
  assignedDisputes    Dispute[]              @relation("DisputeAssignedReviewer")
  escalatedDisputes   Dispute[]              @relation("DisputeEscalatedReviewer")

  // Phase 4 relations
  createdApiKeys         ApiKey[]
  createdWebhookEndpoints OutboundWebhookEndpoint[]
  connectedEcosystems    EcosystemConnector[]
  calendarMeetings       CalendarMeetingEvent[]
  portableWorkReports    PortableWorkReport[]

  // Phase 5 relations
  createdSsoProviders        SsoProvider[]
  proposedPolicyChanges      PolicyChangeRequest[]      @relation("PolicyChangeProposer")
  firstApprovedPolicyChanges PolicyChangeRequest[]      @relation("PolicyChangeFirstApprover")
  secondApprovedPolicyChanges PolicyChangeRequest[]     @relation("PolicyChangeSecondApprover")
  sensitiveAccessLogs        SensitiveAccessLog[]
  placedLegalHolds           LegalHold[]                @relation("LegalHoldPlacer")
  releasedLegalHolds         LegalHold[]                @relation("LegalHoldReleaser")
  createdRetentionPolicies   RetentionPolicy[]
  executedRetentionJobs      RetentionJob[]
  privacyRequests            PrivacyRequest[]
  updatedResidencyConfigs    TenantResidencyConfig[]
  createdSiemDestinations    SiemDestination[]
  publishedFleetReleases     FleetRelease[]
  triggeredWarehouseExports  AnalyticsWarehouseExport[]
  conductedDrExercises       DrExercise[]

  @@map("user_profiles")
}

model Membership {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       String    @default("invited")
  invitedEmail String?   @map("invited_email")
  invitedBy    String?   @map("invited_by") @db.Uuid
  joinedAt     DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          UserProfile  @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedByUser UserProfile? @relation("InvitedByUser", fields: [invitedBy], references: [id])
  roleGrants    RoleGrant[]
  permissionGrants MemberPermissionGrant[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId, userId, status], map: "idx_memberships_tenant_user_status")
  @@map("memberships")
}

model RoleGrant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  role           String
  projectScopeId String?  @map("project_scope_id") @db.Uuid
  grantedBy      String?  @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership    Membership   @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  grantedByUser UserProfile? @relation(fields: [grantedBy], references: [id])

  @@unique([membershipId, role, projectScopeId])
  @@index([tenantId, membershipId, role], map: "idx_role_grants_tenant_membership")
  @@map("role_grants")
}

model TenantSettings {
  tenantId                          String   @id @map("tenant_id") @db.Uuid
  businessWeekDays                  Int[]    @default([1, 2, 3, 4, 5]) @map("business_week_days")
  roundingRule                      String   @default("none") @map("rounding_rule")
  paidBreakAllowanceMinutes         Int      @default(15) @map("paid_break_allowance_minutes")
  deepWorkNoInputWindowMinutes      Int      @default(90) @map("deep_work_no_input_window_minutes")
  idleClarificationThresholdMinutes Int      @default(15) @map("idle_clarification_threshold_minutes")
  weeklyCapMinutes                  Int      @default(2400) @map("weekly_cap_minutes")
  invoicePrefix                     String   @default("INV") @map("invoice_prefix")
  brandingConfig                    Json     @default("{}") @map("branding_config")
  updatedAt                         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model PolicyVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  versionCode     String   @map("version_code")
  effectiveFrom   DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  captureScope    Json     @default("{}") @map("capture_scope")
  summaryMarkdown String   @map("summary_markdown")
  publishedBy     String?  @map("published_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publishedByUser UserProfile?          @relation(fields: [publishedBy], references: [id])
  consents        PolicyConsent[]
  workSessions    WorkSession[]
  changeRequests  PolicyChangeRequest[]

  @@unique([tenantId, versionCode])
  @@unique([id, tenantId])
  @@map("policy_versions")
}

model PolicyConsent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  policyVersionId String   @map("policy_version_id") @db.Uuid
  consentedAt     DateTime @default(now()) @map("consented_at") @db.Timestamptz(6)
  deviceMetadata  Json     @default("{}") @map("device_metadata")

  user          UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion @relation(fields: [policyVersionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, userId, policyVersionId])
  @@index([tenantId, userId, policyVersionId], map: "idx_policy_consents_tenant_user")
  @@map("policy_consents")
}

model Device {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  deviceName            String    @map("device_name")
  osPlatform            String    @map("os_platform")
  agentVersion          String    @map("agent_version")
  deviceFingerprintHash String    @map("device_fingerprint_hash")
  updateChannel         String    @default("stable") @map("update_channel")
  lastClockDriftSeconds Int       @default(0) @map("last_clock_drift_seconds")
  clockAnomalyDetected  Boolean   @default(false) @map("clock_anomaly_detected")
  multiDisplayPolicy    String    @default("coarse_metadata_only") @map("multi_display_policy")
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           UserProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventBatches   ActivityEventBatch[]
  activityEvents ActivityEvent[]

  @@unique([id, tenantId, userId])
  @@map("devices")
}

model AuditEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  actionType      String   @map("action_type")
  targetEntity    String   @map("target_entity")
  targetId        String?  @map("target_id") @db.Uuid
  reason          String?
  beforeState     Json?    @map("before_state")
  afterState      Json?    @map("after_state")
  policyVersionId String?  @map("policy_version_id") @db.Uuid
  correlationId   String?  @map("correlation_id")
  occurredAtUtc   DateTime @default(now()) @map("occurred_at_utc") @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser UserProfile? @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, occurredAtUtc(sort: Desc)], map: "idx_audit_entries_tenant_occurred")
  @@map("audit_entries")
}

// -----------------------------------------------------------------------------
// 2. Projects, Task Hierarchy, Assignments, Work Modes & Notes (0002)
// -----------------------------------------------------------------------------

model Project {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  code                   String
  name                   String
  description            String?
  clientName             String   @map("client_name")
  status                 String   @default("active")
  evidencePolicyOverride Json?    @map("evidence_policy_override")
  boardConfig            Json?    @map("board_config")
  createdBy              String?  @map("created_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser  UserProfile?    @relation(fields: [createdBy], references: [id])
  projectMembers ProjectMember[]
  sprints        Sprint[]
  tasks          Task[]
  contracts      Contract[]
  timesheets     Timesheet[]
  invoiceDrafts  InvoiceDraft[]
  repositoryLinks          RepositoryLink[]
  evidenceArtifacts        EvidenceArtifact[]
  evidenceCorrelationEdges EvidenceCorrelationEdge[]
  calendarMeetingEvents    CalendarMeetingEvent[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status], map: "idx_projects_tenant_status")
  @@map("projects")
}

model ProjectMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  projectRole String   @map("project_role")
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  project Project     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, userId])
  @@index([tenantId, projectId, userId, projectRole], map: "idx_project_members_lookup")
  @@map("project_members")
}

model Sprint {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  name      String
  goal      String?
  status    String    @default("planned")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tasks   Task[]

  @@index([tenantId, projectId, status], map: "idx_sprints_tenant_project_status")
  @@map("sprints")
}

model Task {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  parentTaskId       String?   @map("parent_task_id") @db.Uuid
  sprintId           String?   @map("sprint_id") @db.Uuid
  code               String
  title              String
  description        String?
  acceptanceCriteria String    @default("") @map("acceptance_criteria")
  issueType          String    @default("task") @map("issue_type")
  status             String    @default("backlog")
  priority           String    @default("medium")
  labels             String[]  @default([])
  storyPoints        Int?      @map("story_points")
  boardOrder         Int       @default(0) @map("board_order")
  estimateMinutes    Int       @default(120) @map("estimate_minutes")
  isBillable         Boolean   @default(true) @map("is_billable")
  defaultWorkMode    String    @default("coding") @map("default_work_mode")
  dueDate            DateTime? @map("due_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project      Project          @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sprint       Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTask   Task?            @relation("TaskHierarchy", fields: [parentTaskId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: SetNull)
  subtasks     Task[]           @relation("TaskHierarchy")
  assignments  TaskAssignment[]
  notes        TaskNote[]
  workSessions WorkSession[]
  timeSegments TimeSegment[]
  ideMappings  IdeWorkspaceMapping[]
  evidenceLinks EvidenceLink[]

  @@unique([tenantId, code])
  @@unique([id, tenantId, projectId])
  @@index([tenantId, projectId, status], map: "idx_tasks_tenant_project_status")
  @@index([tenantId, projectId, parentTaskId], map: "idx_tasks_parent_task")
  @@index([tenantId, projectId, sprintId], map: "idx_tasks_sprint")
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  task           Task         @relation(fields: [taskId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: Cascade)
  user           UserProfile  @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser UserProfile? @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@unique([tenantId, taskId, userId])
  @@index([tenantId, userId, taskId], map: "idx_task_assignments_user")
  @@map("task_assignments")
}

model TaskNote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  contentMarkdown String   @map("content_markdown")
  attachmentPaths String[] @default([]) @map("attachment_paths")
  externalLinks   Json     @default("[]") @map("external_links")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task   Task        @relation(fields: [taskId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: Cascade)
  author UserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("task_notes")
}

// -----------------------------------------------------------------------------
// 3. Time Ledger, Work Sessions, Deep-Work Modes & Segments (0003)
// -----------------------------------------------------------------------------

model WorkSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  deviceId            String?   @map("device_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  taskId              String    @map("task_id") @db.Uuid
  provenance          String    @default("desktop_timer")
  lifecycleState      String    @default("running") @map("lifecycle_state")
  currentWorkMode     String    @default("coding") @map("current_work_mode")
  startedAtUtc        DateTime  @default(now()) @map("started_at_utc") @db.Timestamptz(6)
  endedAtUtc          DateTime? @map("ended_at_utc") @db.Timestamptz(6)
  monotonicDurationMs BigInt    @default(0) @map("monotonic_duration_ms")
  clockDriftSeconds   Int       @default(0) @map("clock_drift_seconds")
  sessionNotes        String    @default("") @map("session_notes")
  outcomeSummary      String    @default("") @map("outcome_summary")
  manualReason        String?   @map("manual_reason")
  policyVersionId     String    @map("policy_version_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task            @relation(fields: [taskId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: Restrict)
  policyVersion PolicyVersion   @relation(fields: [policyVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  modeEvents    WorkModeEvent[]
  breaks        Break[]
  timeSegments  TimeSegment[]
  eventBatches  ActivityEventBatch[]
  activityEvents ActivityEvent[]
  activityRollups ActivityRollup[]
  annotations   SessionAnnotation[]

  @@unique([id, tenantId, userId])
  @@index([tenantId, userId, startedAtUtc(sort: Desc)], map: "idx_work_sessions_tenant_user_started")
  @@index([tenantId, projectId, startedAtUtc(sort: Desc)], map: "idx_work_sessions_tenant_project")
  @@map("work_sessions")
}

model WorkModeEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  workMode     String    @map("work_mode")
  startedAtUtc DateTime  @map("started_at_utc") @db.Timestamptz(6)
  endedAtUtc   DateTime? @map("ended_at_utc") @db.Timestamptz(6)
  declaredNote String?   @map("declared_note")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session WorkSession @relation(fields: [sessionId, tenantId, userId], references: [id, tenantId, userId], onDelete: Cascade)

  @@map("work_mode_events")
}

model Break {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  breakType    String    @default("unpaid") @map("break_type")
  startedAtUtc DateTime  @map("started_at_utc") @db.Timestamptz(6)
  endedAtUtc   DateTime? @map("ended_at_utc") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session WorkSession @relation(fields: [sessionId, tenantId, userId], references: [id, tenantId, userId], onDelete: Cascade)

  @@map("breaks")
}

model TimeSegment {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  projectId               String                   @map("project_id") @db.Uuid
  taskId                  String                   @map("task_id") @db.Uuid
  sessionId               String                   @map("session_id") @db.Uuid
  workDate                DateTime                 @map("work_date") @db.Date
  segmentRange            Unsupported("tstzrange") @map("segment_range")
  workMode                String                   @map("work_mode")
