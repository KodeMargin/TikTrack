  checksum       String
  runCount       Int      @default(1) @map("run_count")
  firstAppliedAt DateTime @default(now()) @map("first_applied_at") @db.Timestamptz(6)
  lastAppliedAt  DateTime @default(now()) @map("last_applied_at") @db.Timestamptz(6)

  @@map("system_seed_runs")
}
