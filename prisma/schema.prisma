  overriddenByUser Boolean  @default(false) @map("overridden_by_user")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task        Task             @relation(fields: [taskId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: Cascade)
  artifact    EvidenceArtifact @relation(fields: [artifactId, tenantId, projectId], references: [id, tenantId, projectId], onDelete: Cascade)
  timeSegment TimeSegment?     @relation(fields: [timeSegmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, taskId, artifactId])
  @@index([tenantId, taskId, linkType], map: "idx_evidence_links_task")
  @@map("evidence_links")
}

model SessionAnnotation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  timeSegmentId    String?  @map("time_segment_id") @db.Uuid
  annotationType   String   @default("thinking_note") @map("annotation_type")
  title            String
  contentMarkdown  String   @map("content_markdown")
  startMinuteOfDay Int?     @map("start_minute_of_day")
  endMinuteOfDay   Int?     @map("end_minute_of_day")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     WorkSession  @relation(fields: [sessionId, tenantId, userId], references: [id, tenantId, userId], onDelete: Cascade)
  timeSegment TimeSegment? @relation(fields: [timeSegmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, sessionId, createdAt], map: "idx_session_annotations_session")
  @@map("session_annotations")
}

