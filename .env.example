# DevProof (TikTrack) - Vite Client & Server Environment Variables
# CRITICAL SECURITY RULE (Section 12.4):
# Only public/publishable/anon keys may use the VITE_ prefix.
# NEVER place SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, or webhook secrets with VITE_.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-or-project-publishable-key
VITE_APP_ENV=development



# Server-side Prisma ORM -> Supabase PostgreSQL (Node / Vite server middleware only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
