# DevProof (TikTrack) — Supabase + Prisma ORM Environment Variables
#
# 1. Vite Client Variables (Safe for browser bundle):
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_APP_ENV=development

# 2. Prisma ORM Database Connection (Server-only — NEVER prefix with VITE_):
# Connect to Supabase via Supavisor connection pooling (port 6543) with ?pgbouncer=true
DATABASE_URL=""

# Direct connection to the database Used by Prisma CLI for migrations & introspection (port 5432)
DIRECT_URL=""
