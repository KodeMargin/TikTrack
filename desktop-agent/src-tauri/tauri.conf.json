{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTrack",
  "version": "0.2.0",
  "identifier": "com.tiktrack.desktopagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TikTrack Desktop Timer",
        "width": 400,
        "height": 600,
        "resizable": false
      }
    ],
    "trayIcon": {
      "id": "tiktrack-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "TikTrack Desktop Timer - Transparent Session Status",
      "title": "TikTrack Idle"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

