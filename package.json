{
  "name": "tiktrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -b && vite build && npm run build:api",
    "build:api": "rolldown src/server/vercelPrismaEntry.ts --file api/prisma.mjs --format esm --platform node --external @prisma/client --external @prisma/adapter-pg --external pg --external dotenv --external @supabase/supabase-js",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/time-engine/__tests__/*.test.ts",
    "worker": "node --experimental-strip-types src/worker/detachableQueueWorker.ts",
    "verify:scale": "node --experimental-strip-types scripts/phase5-load-and-dr-drill.ts",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:guards": "node --experimental-strip-types scripts/apply-live-guards.ts",
    "db:setup": "prisma db push && npm run db:guards",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "release:macos": "bash scripts/release-macos-local.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/pg": "^8.23.1",
    "countries-and-timezones": "^3.11.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prisma": "^8.0.0-rc.35",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
